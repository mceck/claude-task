# Hostname is mandatory and intentionally has no default. Supply hostname only.
VOICE_TURN_HOST=
# Same secret for backend and coturn. Generate: openssl rand -hex 32
VOICE_TURN_SECRET=
# Public IPv4 advertised by coturn, with identical relay port forwarding through NAT.
VOICE_TURN_EXTERNAL_IP=
VOICE_TURN_PORT=3478
# Empty disables TLS. Set a free public TCP port and provide certificate files to enable it.
VOICE_TURN_TLS_PORT=
VOICE_TURN_CERTS_DIR=./deploy/turn/certs
VOICE_TURN_TTL_SECONDS=86400
