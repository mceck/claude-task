# Backend configuration (see backend/src/config.ts)
DATABASE_URL=postgres://localhost:5432/claude_task
PORT=3000
DATA_DIR=./.data
# Created on first boot when the database has no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
# Set to false only for plain-http local development in browsers that refuse Secure cookies.
COOKIE_SECURE=true
# Set when running behind a reverse proxy, so client IPs (rate limiting) come from X-Forwarded-For.
TRUST_PROXY=false

# Agents (docs/specs/agents.md)
# Required: encrypts Credentials and secret env vars. Generate with `openssl rand -base64 32`; never change it casually.
SECRETS_MASTER_KEY=
# How Agent Containers reach this backend. With docker compose, the backend's service URL on AGENT_NETWORK.
AGENT_BACKEND_URL=http://host.docker.internal:3000
# Docker network Agent Containers join (leave empty for the default bridge).
AGENT_NETWORK=
# `docker` (default) manages containers through the Docker socket; `fake` simulates them.
AGENT_RUNTIME=docker
# Stop Agent Containers on backend shutdown, keeping their volumes. Defaults to true
# in local development, false with NODE_ENV=production. Uncomment to override.
# AGENT_STOP_ON_SHUTDOWN=true
# Stop an Agent's container while it has no work (no Job, empty Queue, no idle or running
# Session), and start it again when work arrives. Defaults to true.
# AGENT_STOP_WHEN_UNUSED=true
DOCKER_SOCKET=/var/run/docker.sock
# Docker Compose only: group id of the host socket (Linux: `stat -c %g /var/run/docker.sock`).
DOCKER_GID=0
# Pinned Claude Code version for the Base Image; changing it rebuilds every Agent image.
CLAUDE_CODE_VERSION=2.1.310

# Git Integration (docs/specs/git-integration.md)
# Public web URL used in pull request links back to tasks (not the internal container URL).
APP_URL=http://localhost:3000
AGENT_COMMIT_EMAIL_DOMAIN=agents.claude-task.local
# Optional Git Connections from the environment (read-only in the admin Git page, where more
# connections can be added). `env-github`: a GitHub App.
GITHUB_APP_ID=
# RSA PEM private key. A quoted value with escaped newlines (\n) is supported.
GITHUB_APP_PRIVATE_KEY=
# Opt-in live provider contract test only: a dedicated repository accessible to the test App.
GITHUB_CONTRACT_REPOSITORY=
# `env-gitlab`: a GitLab instance and a token with the api and write_repository scopes (at least
# Developer on the projects to link). Environment tokens aren't rotated automatically.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# Opt-in live GitLab contract test only.
GITLAB_CONTRACT_URL=
GITLAB_CONTRACT_TOKEN=
GITLAB_CONTRACT_PROJECT=

# Phone push: Firebase service account JSON mounted outside the repository.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Direct P2P voice: comma-separated STUN URLs; empty = host candidates only.
VOICE_STUN_URLS=stun:stun.l.google.com:19302

# Optional authenticated TURN. Hostname has no default; leave host and secret empty to disable.
VOICE_TURN_HOST=
VOICE_TURN_SECRET=
VOICE_TURN_PORT=3478
# Optional public TLS port; its certificate must be installed on the TURN server.
VOICE_TURN_TLS_PORT=
VOICE_TURN_TTL_SECONDS=86400
